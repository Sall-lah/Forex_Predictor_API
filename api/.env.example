# Forex Predictor API - Environment Configuration
# Copy this file to api/.env and fill in your values

# Application settings
ENVIRONMENT=development
LOG_LEVEL=info

# API settings
API_VERSION=v1
API_PREFIX=/api/v1

# Kraken API settings
KRAKEN_OHLC_URL=https://api.kraken.com/0/public/OHLC
KRAKEN_TIMEOUT=15.0

# ML Model settings
MODEL_DIR=app/features/prediction/ml_models
MODEL_FILENAME=lightgbm_model_forex.pkl

# Feature extraction settings
MIN_ROWS_FOR_FEATURES=168

# Rate limit defaults
RATE_LIMIT_DEFAULT_CAPACITY=60
RATE_LIMIT_DEFAULT_REFILL_RATE_PER_SECOND=1.0
RATE_LIMIT_PREDICTION_CAPACITY=10
RATE_LIMIT_PREDICTION_REFILL_RATE_PER_SECOND=0.1667
RATE_LIMIT_HISTORICAL_CAPACITY=100
RATE_LIMIT_HISTORICAL_REFILL_RATE_PER_SECOND=1.6667

# Storage safety controls
RATE_LIMIT_STORAGE_MAX_ENTRIES=100000
RATE_LIMIT_STORAGE_TTL_SECONDS=3600

# Proxy and path controls
RATE_LIMIT_TRUSTED_PROXY_IPS=
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json