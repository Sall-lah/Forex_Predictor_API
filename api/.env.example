# Forex Predictor API - Example Environment Configuration
# Copy this file to .env and fill in values.

# Application settings
ENVIRONMENT=development
LOG_LEVEL=info

# API settings
API_VERSION=v1
API_PREFIX=/api/v1

# Provider API settings
DATA_PROVIDER=kraken
KRAKEN_OHLC_URL=https://api.kraken.com/0/public/OHLC
KRAKEN_TIMEOUT=15.0

# ML Model settings
MODEL_DIR=app/features/prediction/ml_models
MODEL_FILENAME=lightgbm_model_forex.pkl

# Feature extraction settings
MIN_ROWS_FOR_FEATURES=168

# Trading subscriptions (JSON list of {"pair": str, "interval": int})
TRADING_SUBSCRIPTIONS=[{"pair":"BTC/USD","interval":1},{"pair":"BTC/USD","interval":5},{"pair":"BTC/USD","interval":15},{"pair":"BTC/USD","interval":60},{"pair":"BTC/USD","interval":240},{"pair":"ETH/USD","interval":1},{"pair":"ETH/USD","interval":5},{"pair":"ETH/USD","interval":15},{"pair":"ETH/USD","interval":60},{"pair":"ETH/USD","interval":240}]
