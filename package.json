{
  "name": "forex-predictor-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix web",
    "dev:api": "cd api && uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm run dev --prefix web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "start:api": "cd api && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start:web": "node web/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "npm-run-all": "^4.1.5"
  }
}